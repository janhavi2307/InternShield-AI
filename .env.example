# =========================================================
# INTERNSHIELD AI - ENVIRONMENT VARIABLE TEMPLATE
# =========================================================
#
# IMPORTANT:
# - This file contains placeholders only.
# - Never put real passwords, API keys, tokens or secret values here.
# - Copy this file to .env and add real values locally.
# - The real .env file must never be committed to GitHub.
# =========================================================


# ---------------------------------------------------------
# SUPABASE - MAIN APPLICATION
# ---------------------------------------------------------

SUPABASE_URL=https://your-project.supabase.co

# Public / publishable Supabase key used by the normal
# authenticated application flow.
SUPABASE_KEY=your-supabase-publishable-key


# ---------------------------------------------------------
# SUPABASE - SERVER / ADMIN ACCESS
# ---------------------------------------------------------

# Server-only Supabase secret key used for administrative
# operations such as the Support Inbox.
#
# NEVER expose this value in HTML, JavaScript or frontend code.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Legacy alternative if your Supabase project still uses it:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ---------------------------------------------------------
# FLASK
# ---------------------------------------------------------

# Generate a long random secret for production.
FLASK_SECRET_KEY=replace-with-a-long-random-secret


# ---------------------------------------------------------
# SERVER-SIDE SESSION STORAGE
# ---------------------------------------------------------

# Required for serverless deployment such as Vercel.
#
# Use the secure Upstash Redis TCP connection URL.
# It should begin with:
# rediss://
#
# Example format only:
# REDIS_URL=rediss://default:password@host.upstash.io:6379
#
# Never commit the real Redis URL.
REDIS_URL=


# ---------------------------------------------------------
# SUPPORT INBOX / ADMIN ACCESS
# ---------------------------------------------------------

# Email address allowed to access the Support Inbox.
# Multiple email addresses can be comma-separated.
SUPPORT_ADMIN_EMAILS=your-admin@example.com


# ---------------------------------------------------------
# SMTP EMAIL - OPTIONAL / LEGACY FALLBACK
# ---------------------------------------------------------

# These settings may be kept if SMTP fallback support
# still exists in the application.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USE_TLS=true
SMTP_USE_SSL=false

SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password

SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=InternShield Support


# ---------------------------------------------------------
# TRANSACTIONAL EMAIL - BREVO HTTPS API
# ---------------------------------------------------------

EMAIL_PROVIDER=brevo

BREVO_API_KEY=your-brevo-api-key

BREVO_SENDER_EMAIL=your-verified-sender@example.com

BREVO_SENDER_NAME=InternShield Support


# ---------------------------------------------------------
# GEMINI AI
# ---------------------------------------------------------

# Gemini API key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key

# Working model currently used by InternShield.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallback model.
# Leave blank unless another model is configured.
GEMINI_FALLBACK_MODEL=

# Enable or disable Gemini without changing code.
GEMINI_AI_ENABLED=true

# Maximum Gemini request time in milliseconds.
GEMINI_TIMEOUT_MS=15000


# ---------------------------------------------------------
# APPLICATION ENVIRONMENT
# ---------------------------------------------------------

# Local development:
APP_ENV=development

# On Render or Vercel set:
# APP_ENV=production


# ---------------------------------------------------------
# PUBLIC DEPLOYMENT URL
# ---------------------------------------------------------

# Local development:
# Leave blank if the app should determine the URL automatically.

# Render example:
# PUBLIC_BASE_URL=https://your-project.onrender.com

# Vercel example:
# PUBLIC_BASE_URL=https://your-project.vercel.app

PUBLIC_BASE_URL=